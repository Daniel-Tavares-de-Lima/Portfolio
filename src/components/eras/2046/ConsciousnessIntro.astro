---
import { useTranslations, type Locale } from '../../../i18n';

interface Props {
  locale: Locale;
  year: string;
}

const { locale, year } = Astro.props;
const t = useTranslations(locale);
const other = locale === 'pt' ? 'en' : 'pt';
---
<div class="consciousness-intro" id="consciousness-intro" role="button" tabindex="0" aria-label={t.era2046.tap_to_continue}>
  <a href={`/${other}/${year}`} class="consciousness-lang consciousness-lang--intro">{locale === 'pt' ? 'EN' : 'PT'}</a>
  <p class="consciousness-glitch">{t.era2046.glitch_line}</p>
  <p class="consciousness-tap">{t.era2046.tap_to_continue}</p>
</div>

<script is:inline>
  (function initConsciousnessIntro() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function reveal() {
      document.getElementById('consciousness-intro')?.classList.add('is-hidden');
      document.getElementById('consciousness-stream')?.classList.add('is-visible');
    }

    function bind() {
      if (reduced) {
        reveal();
        return;
      }

      const intro = document.getElementById('consciousness-intro');
      intro?.addEventListener('click', (e) => {
        const target = e.target;
        if (target && target.closest && target.closest('a')) return;
        reveal();
      });
      intro?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          reveal();
        }
      });

      setTimeout(reveal, 4500);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bind);
    } else {
      bind();
    }
  })();
</script>
