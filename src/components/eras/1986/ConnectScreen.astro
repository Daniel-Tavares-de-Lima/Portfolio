---
import { useTranslations, type Locale } from '../../../i18n';

interface Props {
  locale: Locale;
  year: string;
}

const { locale, year } = Astro.props;
const t = useTranslations(locale);
const other = locale === 'pt' ? 'en' : 'pt';
---
<div class="connect-screen" id="connect-screen">
  <a href={`/${other}/${year}`} class="bbs-lang bbs-lang--connect">{locale === 'pt' ? 'EN' : 'PT'}</a>
  <div class="terminal-chrome" aria-hidden="true">NODE://RECIFE-BR ───</div>
  <h1 class="bbs-type-target" data-text={t.era1986.bbs_title}></h1>
  <p class="specs bbs-type-target" data-text={t.era1986.specs}></p>
  <p class="dialing-msg" id="dialing-msg" aria-live="polite"></p>
  <button type="button" class="connect-btn" id="connect-btn" hidden>► {t.era1986.connect}</button>
  <p class="connect-hint bbs-type-target" data-text={t.era1986.press_to_dial}></p>
</div>
