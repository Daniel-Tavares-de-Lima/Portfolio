---
import satre from '../../../data/satre.json';
import ImageLightbox from './ImageLightbox.astro';
import { useTranslations, type Locale } from '../../../i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<section id="satre" class="satre-section">
  <div class="container">
    <div class="satre-header">
      <div>
        <span class="tag status">{satre.status[locale]}</span>
        <h2>{satre.name}</h2>
        <p class="full-name">{satre.fullName[locale]}</p>
        <p class="role-meta">
          {satre.role[locale]} · {satre.period[locale]}
        </p>
        <p class="tagline">{satre.tagline[locale]}</p>
        <a href={satre.github} class="btn btn-outline satre-github" target="_blank" rel="noopener">
          {t.projects.view_github}
        </a>
      </div>
      <ImageLightbox
        src={satre.images.intro}
        alt={`${satre.name} — ${satre.fullName[locale]}`}
        caption={t.satre.intro_caption}
        expandLabel={t.common.expand_image}
        closeLabel={t.common.close}
        variant="compact"
      />
    </div>

    <div class="satre-body">
      <div class="satre-text">
        {satre.description[locale].map(paragraph => (
          <p>{paragraph}</p>
        ))}
        <div class="stack-tags">
          {satre.stack.map(tech => <span class="tag">{tech}</span>)}
        </div>
      </div>

      <div class="satre-features-grid">
        <h3>{t.satre.features_title}</h3>
        {satre.features[locale].map(feature => (
          <div class="feature-card card">
            <h4>{feature.title}</h4>
            <p>{feature.description}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="satre-benefits card">
      <h3>{t.satre.benefits_title}</h3>
      <ul>
        {satre.benefits[locale].map(benefit => (
          <li><span class="plus">+</span> {benefit}</li>
        ))}
      </ul>
    </div>

    <div class="satre-gallery">
      <ImageLightbox
        src={satre.images.screens}
        alt={t.satre.screens_alt}
        caption={t.satre.screens_caption}
        expandLabel={t.common.expand_image}
        closeLabel={t.common.close}
      />
      <ImageLightbox
        src={satre.images.features}
        alt={t.satre.features_alt}
        caption={t.satre.features_caption}
        expandLabel={t.common.expand_image}
        closeLabel={t.common.close}
      />
    </div>
  </div>
</section>

<style>
  .satre-section {
    --satre-accent: #3d9a96;
    border-top: 3px solid var(--satre-accent);
  }

  .satre-header {
    display: grid;
    grid-template-columns: 1fr min(320px, 40%);
    gap: 2rem;
    align-items: center;
    margin-bottom: 2.5rem;
  }

  .status {
    background: color-mix(in srgb, var(--satre-accent) 15%, transparent);
    border-color: var(--satre-accent);
    color: var(--satre-accent);
    margin-bottom: 0.75rem;
    display: inline-block;
  }

  .satre-section h2 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    margin-bottom: 0.25rem;
  }

  .full-name {
    font-size: clamp(0.95rem, 2.5vw, 1.05rem);
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .role-meta {
    font-weight: 500;
    color: var(--satre-accent);
    margin-bottom: 0.75rem;
    font-size: clamp(0.875rem, 2vw, 1rem);
  }

  .tagline {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 520px;
    margin-bottom: 1rem;
  }

  .satre-github {
    margin-top: 0.25rem;
    border-color: var(--satre-accent);
    color: var(--satre-accent);
  }

  .satre-github:hover {
    background: var(--satre-accent);
    color: #fff;
  }

  .satre-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .satre-text p {
    color: var(--text-secondary);
    margin-bottom: 1rem;
    line-height: 1.75;
  }

  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .satre-features-grid h3,
  .satre-benefits h3 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .feature-card {
    margin-bottom: 0.75rem;
    border-left: 3px solid var(--satre-accent);
  }

  .feature-card:hover {
    transform: none;
  }

  .feature-card h4 {
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }

  .feature-card p {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .satre-benefits {
    margin-bottom: 2rem;
    background: color-mix(in srgb, var(--satre-accent) 8%, var(--card-bg));
  }

  .satre-benefits ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .satre-benefits li {
    color: var(--text-secondary);
    font-weight: 500;
    font-size: clamp(0.875rem, 2vw, 1rem);
  }

  .plus {
    color: var(--satre-accent);
    font-weight: 700;
    margin-right: 0.25rem;
  }

  .satre-gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .satre-header {
      grid-template-columns: 1fr;
    }
    .satre-body {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .satre-benefits ul {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
