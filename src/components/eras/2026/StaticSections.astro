---
import Hero from '../2016/Hero.astro';
import About from '../2016/About.astro';
import ExperienceTimeline from '../2016/ExperienceTimeline.astro';
import ProjectGrid from '../2016/ProjectGrid.astro';
import Contact from '../2016/Contact.astro';
import type { Locale } from '../../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---
<div class="static-sections static-fallback">
  <div class="glass-section"><Hero locale={locale} /></div>
  <div class="glass-section"><About locale={locale} /></div>
  <div class="glass-section"><ExperienceTimeline locale={locale} /></div>
  <div class="glass-section"><ProjectGrid locale={locale} /></div>
  <div class="glass-section"><Contact locale={locale} /></div>
</div>

<div class="static-sections" id="agent-sections">
  <div class="glass-section"><About locale={locale} /></div>
  <div class="glass-section"><ExperienceTimeline locale={locale} /></div>
  <div class="glass-section"><ProjectGrid locale={locale} /></div>
  <div class="glass-section"><Contact locale={locale} /></div>
</div>
