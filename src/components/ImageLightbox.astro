---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  expandLabel: string;
  closeLabel: string;
  variant?: 'default' | 'avatar' | 'compact';
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt,
  caption,
  expandLabel,
  closeLabel,
  variant = 'default',
  loading = 'lazy',
} = Astro.props;
---
<figure class:list={['lightbox-figure', variant !== 'default' && `lightbox-figure--${variant}`]}>
  <button type="button" class="lightbox-trigger" aria-label={expandLabel}>
    <img src={src} alt={alt} loading={loading} />
    <span class="expand-hint" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
      </svg>
      {expandLabel}
    </span>
  </button>
  {caption && <figcaption>{caption}</figcaption>}

  <dialog class="lightbox-dialog" aria-label={alt}>
    <div class="lightbox-backdrop" data-close></div>
    <div class="lightbox-panel">
      <button type="button" class="lightbox-close" aria-label={closeLabel} data-close>✕</button>
      <img src={src} alt={alt} class="lightbox-full" />
      {caption && <p class="lightbox-caption">{caption}</p>}
    </div>
  </dialog>
</figure>

<style>
  .lightbox-figure {
    margin: 0;
  }

  .lightbox-trigger {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--card-bg);
    cursor: zoom-in;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .lightbox-trigger:hover {
    border-color: var(--accent);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
  }

  .lightbox-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .lightbox-trigger img {
    width: 100%;
    display: block;
    border-radius: 0.75rem;
  }

  .expand-hint {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.6rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.65));
    color: #fff;
    font-size: 0.85rem;
    font-weight: 500;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .lightbox-trigger:hover .expand-hint,
  .lightbox-trigger:focus-visible .expand-hint {
    opacity: 1;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-align: center;
  }

  .lightbox-dialog {
    position: fixed;
    inset: 0;
    z-index: 1000;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
  }

  .lightbox-dialog::backdrop {
    background: rgba(0, 0, 0, 0.85);
  }

  .lightbox-dialog[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    cursor: zoom-out;
  }

  .lightbox-panel {
    position: relative;
    z-index: 1;
    max-width: min(95vw, 1200px);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem;
  }

  .lightbox-close {
    position: absolute;
    top: -0.25rem;
    right: 0;
    z-index: 2;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 50%;
    background: var(--card-bg);
    color: var(--text-primary);
    font-size: 1.25rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .lightbox-close:hover {
    background: var(--accent);
    color: #fff;
  }

  .lightbox-full {
    max-width: 100%;
    max-height: calc(90vh - 3rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.5rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .lightbox-caption {
    margin-top: 0.75rem;
    color: #e2e8f0;
    font-size: 0.9rem;
    text-align: center;
    max-width: 600px;
  }

  .lightbox-figure--avatar {
    width: clamp(120px, 25vw, 160px);
    flex-shrink: 0;
  }

  .lightbox-figure--avatar .lightbox-trigger {
    border-radius: 50%;
    border: 3px solid var(--accent);
    aspect-ratio: 1;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .lightbox-figure--avatar .lightbox-trigger img {
    border-radius: 50%;
    object-fit: cover;
    object-position: center 15%;
    height: 100%;
  }

  .lightbox-figure--avatar .expand-hint {
    border-radius: 0 0 50% 50%;
    font-size: 0.7rem;
    padding: 0.35rem;
  }

  .lightbox-figure--compact {
    width: 100%;
    max-width: 320px;
    justify-self: end;
  }

  .lightbox-figure--compact .lightbox-trigger img {
    border-radius: 0.75rem;
  }

  @media (max-width: 900px) {
    .lightbox-figure--compact {
      max-width: 100%;
      justify-self: stretch;
    }
  }

  @media (max-width: 768px) {
    .expand-hint {
      opacity: 1;
      font-size: 0.8rem;
      padding: 0.5rem;
    }

    .lightbox-panel {
      max-width: 100vw;
      max-height: 100vh;
      padding: 0.5rem;
    }

    .lightbox-full {
      max-height: calc(100vh - 4rem);
    }

    .lightbox-close {
      top: 0.5rem;
      right: 0.5rem;
      position: fixed;
    }
  }
</style>

<script>
  function initLightboxes() {
    document.querySelectorAll('.lightbox-figure').forEach((figure) => {
      const root = figure as HTMLElement;
      if (root.dataset.bound) return;
      root.dataset.bound = 'true';

      const trigger = root.querySelector('.lightbox-trigger');
      const dialog = root.querySelector('.lightbox-dialog') as HTMLDialogElement | null;
      if (!trigger || !dialog) return;

      const open = () => {
        dialog.showModal();
        document.body.style.overflow = 'hidden';
      };

      const close = () => {
        dialog.close();
        document.body.style.overflow = '';
      };

      trigger.addEventListener('click', open);
      root.querySelectorAll('[data-close]').forEach((el) => {
        el.addEventListener('click', close);
      });

      dialog.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') close();
      });

      dialog.addEventListener('close', () => {
        document.body.style.overflow = '';
      });
    });
  }

  initLightboxes();
  document.addEventListener('astro:page-load', initLightboxes);
</script>
