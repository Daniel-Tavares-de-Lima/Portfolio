---
import { useTranslations, type Locale } from '../../../i18n';
import NeuralHologram from './NeuralHologram.astro';

interface Props {
  locale: Locale;
  year: string;
}

const { locale, year } = Astro.props;
const t = useTranslations(locale);
const other = locale === 'pt' ? 'en' : 'pt';
---
<div class="neural-pairing" id="neural-pairing">
  <div class="neural-pairing-top">
    <p class="neural-brand">{t.era2036.brand}</p>
    <a href={`/${other}/${year}`} class="neural-lang neural-lang--pairing">{locale === 'pt' ? 'EN' : 'PT'}</a>
  </div>
  <NeuralHologram />
  <p class="neural-step">{t.era2036.step}</p>
  <h1 class="neural-title">
    {t.era2036.title_prefix} <span class="highlight">{t.era2036.title_highlight}</span>™
  </h1>
  <p class="neural-subtitle">{t.era2036.subtitle}</p>
  <p class="neural-link-msg" id="neural-link-msg" aria-live="polite"></p>
  <button type="button" class="neural-start" id="neural-start">{t.era2036.start}</button>
</div>

<script is:inline define:vars={{ linkingText: t.era2036.linking, linkedText: t.era2036.linked }}>
  (function initNeuralPairing() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function showContent() {
      document.getElementById('neural-pairing')?.classList.add('is-hidden');
      document.getElementById('neural-content')?.classList.add('is-visible');
    }

    function bind() {
      if (reduced) {
        showContent();
        return;
      }

      const startBtn = document.getElementById('neural-start');
      startBtn?.addEventListener('click', () => {
        if (!startBtn || startBtn.disabled) return;
        startBtn.disabled = true;
        const linkMsg = document.getElementById('neural-link-msg');
        if (linkMsg) linkMsg.textContent = linkingText;

        setTimeout(() => {
          if (linkMsg) linkMsg.textContent = linkedText;
          setTimeout(showContent, 600);
        }, 2200);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bind);
    } else {
      bind();
    }
  })();
</script>
